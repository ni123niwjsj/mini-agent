# ====================================================
# Mini-Agent 环境变量配置模板
# 复制本文件为 .env 并填入你的真实配置：cp .env.example .env
# ====================================================

# 1. 大模型 API Key (若连接本地模型可保持 EMPTY)
OPENAI_API_KEY=EMPTY

# 2. 模型服务接口地址 (Base URL)
# 选项 A: 本地 llama-server / llama.cpp (默认端口 8080)
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1

# 选项 B: 阿里云百炼通义千问 (DashScope)
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 选项 C: DeepSeek 官方 API
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# 选项 D: 官方 OpenAI API
# OPENAI_BASE_URL=https://api.openai.com/v1

# 3. 指定默认调用的模型名称
# 例如: mock (测试模拟) / qwen3.6-35b-a3b / qwen-max / deepseek-chat / gpt-4o
MINI_AGENT_MODEL=mock
